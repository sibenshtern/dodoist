# ── Django ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=false

# Comma-separated — include your domain and the backend service name
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Comma-separated origins allowed for CORS (your frontend domain)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Database (PostgreSQL) ───────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dodoist
DB_USER=dodoist
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Email (optional — remove EMAIL_BACKEND line to use SMTP) ──────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Dodoist <noreply@yourdomain.com>

# ── PostgreSQL container credentials (must match DB_* above) ──────────────────
POSTGRES_DB=dodoist
POSTGRES_USER=dodoist
POSTGRES_PASSWORD=change-me-strong-password
